APP_NAME=Pisti
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ─── Pisti Environment Mode ─────────────────────────────────────────────────
# Set to 'dev' for local development (path-based superadmin, no HTTPS, debug mode)
# Set to 'staging' for testing environment (subdomain-based, HTTPS, some debug)
# Set to 'production' for live environment (subdomain-based, HTTPS, no debug)
PISTI_ENV=dev

# ─── Superadmin Routing Mode ────────────────────────────────────────────────
# 'auto' = Use PISTI_ENV to determine (dev=path, staging|production=subdomain)
# 'path' = Always use path-based (/superadmin)
# 'subdomain' = Always use subdomain-based (superadmin.example.com)
SUPERADMIN_MODE=auto

# ─── Platform Domain Configuration ───────────────────────────────────────────
# The main domain for the platform (used for subdomains in production)
PISTI_PLATFORM_DOMAIN=your-domain.com

# ─── Security Settings ───────────────────────────────────────────────────────
# 'auto' = Use PISTI_ENV to determine (dev=false, staging|production=true)
# 'true' = Force HTTPS always
# 'false' = Allow HTTP
FORCE_HTTPS=auto

# ─── Feature Flags (comma-separated) ─────────────────────────────────────────
# Features to enable in this environment
# Available: impersonation, debug_bar, query_log, email_preview
PISTI_FEATURES=impersonation,debug_bar,query_log

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pisti
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
# SESSION_DOMAIN: Leave empty for localhost, set to .your-domain.com for production
SESSION_DOMAIN=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SMS_URL=https://sms.tenasms.com/api/services/sendsms
SMS_API_KEY=your-sms-api-key
SMS_SHORT_CODE=YourBrand
SMS_PARTNER_ID=your-partner-id

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_LNMO_PASSKEY=
MPESA_SHORTCODE=your-shortcode
MPESA_STK_URL=https://api.safaricom.co.ke/mpesa/stkpush/v1/processrequest
MPESA_OAUTH_URL=https://api.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
MPESA_C2B_REGISTER_URL=https://api.safaricom.co.ke/mpesa/c2b/v1/registerurl
MPESA_CALLBACK_BASE_URL=https://your-domain.com
MPESA_ACCOUNT_REF="Church Donation"

# ─── Pisti SaaS Platform ────────────────────────────────────────────────────
# Current tenant slug (set dynamically by IdentifyTenant middleware at runtime)
TENANT_SLUG=

# Platform Mpesa paybill used for SaaS subscription billing (not per-tenant)
PISTI_MPESA_SHORTCODE=
PISTI_MPESA_CONSUMER_KEY=
PISTI_MPESA_CONSUMER_SECRET=
PISTI_MPESA_PASSKEY=

# ─── PayStack Payment Gateway ────────────────────────────────────────────────
# Get your keys from https://dashboard.paystack.com/
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYSTACK_IS_LIVE=false
PAYSTACK_CURRENCY=KES

# Horizon dashboard basic-auth (change on production)
HORIZON_USERNAME=pisti-admin
HORIZON_PASSWORD=change-me-on-production

# Laravel ReCaptcha (get keys from Google reCAPTCHA)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Debug Bar (enable in dev only)
DEBUG_BAR_ENABLED=true
